# Copy to Streamlit Cloud → Settings → Secrets. Everything is optional; the app runs anonymously without it.

[tvdatafeed]            # a TradingView login gives real-time /ES and fuller intraday history
username = ""
password = ""

[gsheets]               # mirror the Trade Journal to a Google Sheet so it survives reboots
spreadsheet_key = ""
worksheet = "Trade Journal"
[gsheets.service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
token_uri = "https://oauth2.googleapis.com/token"

[barchart]             # optional: cookies minted elsewhere (e.g. Colab via tools/colab_barchart_check.py), pasted as one JSON line
cookies_json = ""

# ── Barchart cookies — the proven route from your vs3d2 / spxdash repo (any ONE of these):
# BC_COOKIE_URL   = "https://raw.githubusercontent.com/<you>/<repo>/main/data/session/cookies.json"   # the file your mint job commits
# BC_COOKIE_TOKEN = "ghp_..."                                                                          # only if that repo is private
# BC_COOKIES_JSON = '''{"minted_at": ..., "user_agent": "...", "cookies": {...}}'''                 # a minted blob pasted verbatim
