# Copy to Streamlit Cloud → Settings → Secrets. Everything is optional; the app runs anonymously without it.

[tvdatafeed]            # a TradingView login gives real-time /ES and fuller intraday history
username = ""
password = ""

[gsheets]               # mirror the Trade Journal to a Google Sheet so it survives reboots
spreadsheet_key = ""
worksheet = "Trade Journal"
[gsheets.service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
token_uri = "https://oauth2.googleapis.com/token"
